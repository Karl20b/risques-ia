Require all granted
Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(config|seed|password|.*\.(sql|json|log|md))$">
 Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
 Header always set Cache-Control "no-store"
</IfModule>
